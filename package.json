{
  "name": "@dynamicore/corewatch",
  "version": "0.2.0",
  "description": "Lightweight, Sentry-style error monitoring SDK for React, React Native (Expo) and the browser: errors, breadcrumbs, PII scrubbing and pluggable transports.",
  "keywords": [
    "error-monitoring",
    "error-tracking",
    "crash-reporting",
    "observability",
    "breadcrumbs",
    "react",
    "expo",
    "react-native",
    "error-boundary",
    "redux",
    "sentry-alternative",
    "logging"
  ],
  "homepage": "https://github.com/fintcore/corewatch#readme",
  "bugs": {
    "url": "https://github.com/fintcore/corewatch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fintcore/corewatch.git"
  },
  "license": "MIT",
  "author": {
    "name": "DynamiCore",
    "url": "https://dynamicore.io"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "react-native": "./dist/esm/native/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./native.d.ts",
        "default": "./dist/esm/native/index.js"
      },
      "types": "./index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/cjs/react/index.js",
      "default": "./dist/esm/react/index.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js",
      "default": "./dist/esm/core/index.js"
    },
    "./native": {
      "types": "./native.d.ts",
      "react-native": "./dist/esm/native/index.js",
      "import": "./dist/esm/native/index.js",
      "require": "./dist/cjs/native/index.js",
      "default": "./dist/esm/native/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "react/package.json",
    "core/package.json",
    "native.d.ts",
    "native/package.json",
    "index.d.ts",
    "react.d.ts",
    "core.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:cjs": "babel src --out-dir dist/cjs",
    "build:esm": "babel src --out-dir dist/esm --env-name esm",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && node scripts/postbuild.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build && npm run check:exports",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "vitest": "^3.2.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}

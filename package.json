{
  "name": "@dynamicore/corewatch",
  "version": "0.1.0",
  "description": "Lightweight, Sentry-style error monitoring SDK for React and the browser: errors, breadcrumbs, PII scrubbing and pluggable transports.",
  "keywords": [
    "error-monitoring",
    "error-tracking",
    "crash-reporting",
    "observability",
    "breadcrumbs",
    "react",
    "error-boundary",
    "redux",
    "sentry-alternative",
    "logging"
  ],
  "homepage": "https://github.com/fintcore/corewatch#readme",
  "bugs": {
    "url": "https://github.com/fintcore/corewatch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fintcore/corewatch.git"
  },
  "license": "MIT",
  "author": {
    "name": "DynamiCore",
    "url": "https://dynamicore.io"
  },
  "main": "dist/index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --extensions \".js,.jsx\" --delete-dir-on-start",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "corewatch",
  "version": "0.1.0",
  "description": "CoreWatch — Sentry-like client-side error capture for React apps.",
  "author": {
    "name": "DynamiCore",
    "url": "http://dynamicore.io"
  },
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --extensions \".js,.jsx\" --delete-dir-on-start",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
